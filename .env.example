# Copy to .env and fill in. .env is ignored by git.
#   cp .env.example .env

# ---- REQUIRED ---------------------------------------------------------------

# Metaculus bot account token: metaculus.com/accounts/settings/ >
# "My Forecasting Bots" > "Create a Bot", then copy the API key.
METACULUS_TOKEN=

# OpenRouter key. Tournament participants can request free credits at
# https://forms.gle/aQdYMq9Pisrf1v7d8, or create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=


# ---- MODELS (optional, defaults in main.py) --------------------------------

# FORECAST_MODEL=openrouter/openai/gpt-5.4
# RESEARCH_MODEL=openrouter/openai/gpt-5.4:online
# PARSER_MODEL=openrouter/openai/gpt-4o-mini

# Reasoning effort (low, medium, high) for forecasting models and for research.
# REASONING_EFFORT=high
# RESEARCH_REASONING=low

# Models in the binary-question ensemble, comma-separated. ENSEMBLE=0 disables it.
# Avoid the :online suffix here: each member would run its own web search.
# ENSEMBLE_MODELS=openrouter/openai/gpt-5.4,openrouter/anthropic/claude-sonnet-4.6
# ENSEMBLE=0


# ---- RESEARCH PROVIDERS (optional) -----------------------------------------

# Extra providers are detected from the keys below and run alongside the
# primary research model. Claude web search is used whenever OPENROUTER_API_KEY
# is set. RESEARCH_PROVIDERS overrides the automatic list.
# RESEARCH_PROVIDERS=asknews,exa,perplexity,anthropic-search

# AskNews (https://asknews.app): an API key, or an OAuth client id + secret.
# ASKNEWS_API_KEY=
# ASKNEWS_CLIENT_ID=
# ASKNEWS_SECRET=

# Exa (https://exa.ai)
# EXA_API_KEY=

# Perplexity (https://docs.perplexity.ai)
# PERPLEXITY_API_KEY=


# ---- COST ------------------------------------------------------------------

# Cost cap per run, in USD. Web search cost from :online models is not tracked,
# so also set a spending limit on the OpenRouter key itself.
# MAX_COST_PER_RUN=5.00


# ---- CALIBRATION (leave unset until you have resolved questions) -----------

# Platt scaling applied to binary forecasts. A=1, B=0 means no change.
# Fit your own with: uv run python calibration.py resolved.csv
# CALIBRATION_A=1.0
# CALIBRATION_B=0.0
