# Copie para .env e preencha. O .env nunca vai para o git.
#   cp .env.example .env

# ---- OBRIGATORIO ----------------------------------------------------------

# Token da conta de bot na Metaculus.
# Como obter: crie uma conta humana em metaculus.com, va em
# metaculus.com/accounts/settings/ > "My Forecasting Bots" > "Create a Bot",
# preencha e copie a API Key.
METACULUS_TOKEN=

# Chave da OpenRouter. Uma chave so da acesso a modelos da OpenAI, Anthropic
# e Google. O torneio distribui creditos gratis pelo formulario
# https://forms.gle/aQdYMq9Pisrf1v7d8 e o credito vem justamente como chave
# da OpenRouter. Chave propria: https://openrouter.ai/keys
OPENROUTER_API_KEY=


# ---- MODELOS (opcional, ha padrao no main.py) ------------------------------

# O modelo base e o que mais move o placar. Vale testar alternativas.
# FORECAST_MODEL=openrouter/anthropic/claude-sonnet-4.6
# RESEARCH_MODEL=openrouter/anthropic/claude-sonnet-4.6:online
# PARSER_MODEL=openrouter/openai/gpt-4o-mini

# Teto de gasto por execucao, em dolares.
# Atencao: modelos com sufixo :online nao reportam custo, entao esse teto nao
# cobre a etapa de pesquisa. O limite que vale de verdade e o que voce definir
# na propria chave da OpenRouter.
# MAX_COST_PER_RUN=5.00


# ---- CALIBRACAO (deixe vazio ate ter perguntas resolvidas) -----------------

# Ajuste de Platt aplicado depois da agregacao. A=1 e B=0 significam
# "nao mexe". Rode `uv run python calibration.py resolvidas.csv` para
# descobrir os seus. Nao copie coeficiente de ninguem.
# CALIBRATION_A=1.0
# CALIBRATION_B=0.0
